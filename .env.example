# Node Environment
NODE_ENV=production

# POSTGRES_USER=postgres
POSTGRES_USER=your_username
POSTGRES_HOST=your_host
POSTGRES_DB=your_database
POSTGRES_PASSWORD=your_password
POSTGRES_PORT=your_port
JWT_SECRET=your_jwt_secret_key

TALENT_EMAIL=talent@esparkconsultants.com
 
# S3 compatible storage settings
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_BUCKET=your_bucket_name
S3_REGION=your_region
S3_ENDPOINT=your_s3_endpoint_url

# PayFast Configuration
PAYFAST_ENVIRONMENT=your_environment # 'sandbox' or 'production'
PAYFAST_MERCHANT_ID=your_merchant_id
PAYFAST_SECURED_KEY=your_secured_key
PAYFAST_MERCHANT_NAME=your_merchant_name

# PayFast Production URLs (leave empty for sandbox)
PAYFAST_PRODUCTION_TOKEN_URL=your_production_token_url
PAYFAST_PRODUCTION_TRANSACTION_URL=your_production_transaction_url

# PayFast Callback URLs
PAYFAST_SUCCESS_URL=your_backend_url/api/payment/success
PAYFAST_FAILURE_URL=your_backend_url/api/payment/failure
PAYFAST_CHECKOUT_URL=your_backend_url/api/payfast/webhook

# Cron Job Scheduling Configuration
ENABLE_CRON_JOBS=true

CRON_INVOICE_GENERATION=0 2 1 * * # At 02:00 on day-of-month 1
CRON_INVOICE_REMINDER=0 9 * * * # At 09:00 every day
CRON_OVERDUE_CHECKER=0 10 * * * # At 10:00 every day

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_app_password
SMTP_FROM=your_smtp_from_email
SMTP_PORT=465
SMTP_FROM_NAME=Your Company Name